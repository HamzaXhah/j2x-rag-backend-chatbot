# Docker Compose Configuration
COMPOSE_PROJECT_NAME=rag-system

# Common Configuration
APP_ENV=development
LOG_LEVEL=debug

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend Configuration
BACKEND_PORT=8080
# IMPORTANT: Generate a secure random key for production!
# Generate with: openssl rand -hex 32
SECRET_KEY=PLEASE_GENERATE_A_RANDOM_KEY_USE_openssl_rand_hex_32

# Database
DATABASE_USER=raguser
DATABASE_PASSWORD=ragpassword
DATABASE_NAME=ragdb
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb

# MinIO Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# =============================================================================
# ALIBABA CLOUD MODEL STUDIO / QWEN
# =============================================================================
DASHSCOPE_API_KEY=your-alibaba-cloud-model-studio-api-key
# Default is the Singapore shared endpoint. Use the endpoint matching your key's region.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_ENABLE_THINKING=false

# =============================================================================
# LOCAL BGE LARGE EMBEDDINGS
# =============================================================================
BGE_MODEL_NAME=BAAI/bge-large-en-v1.5
BGE_MODEL_PATH=./models/bge-large-en-v1.5
BGE_DEVICE=cuda
BGE_NORMALIZE_EMBEDDINGS=true
EMBEDDING_MODEL_DIMENSIONS=1024

# =============================================================================
# SSL CONFIGURATION (for corporate proxy environments)
# =============================================================================
# Set to "true" to disable SSL verification (use only in development/corporate proxy)
DISABLE_SSL_VERIFICATION=false

# =============================================================================
# DOCUMENT PROCESSING / CHUNKING CONFIGURATION
# =============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Chunking strategy: recursive (default), semantic, token, or sentence
CHUNKING_STRATEGY=recursive
# For semantic chunking: percentile, standard_deviation, interquartile, gradient
SEMANTIC_BREAKPOINT_TYPE=percentile
# Minimum chunk size (prevents very small chunks)
MIN_CHUNK_SIZE=100
# Token-based chunking uses tiktoken's cl100k_base encoding.

# =============================================================================
# RETRIEVAL SETTINGS
# =============================================================================
MAX_RETRIEVED_DOCUMENTS=5

# =============================================================================
# FILE SETTINGS
# =============================================================================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760

# =============================================================================
# FILE WATCHER SETTINGS
# =============================================================================
ENABLE_FILE_WATCHER=true
FILE_WATCHER_INTERVAL=60

# =============================================================================
# SCRAPING SETTINGS
# =============================================================================
SCRAPING_TIMEOUT=30
