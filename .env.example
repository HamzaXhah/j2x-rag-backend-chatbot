# Docker Compose Configuration
COMPOSE_PROJECT_NAME=j2x-rag

# Common Configuration
APP_ENV=production
LOG_LEVEL=info

# Backend Configuration
BACKEND_PORT=8080
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# Database
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=your-db-name
DATABASE_URL=postgresql://your-db-user:your-db-password@db:5432/your-db-name

# MinIO Object Storage
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_SECURE=false

# =============================================================================
# ALIBABA CLOUD MODEL STUDIO / QWEN
# =============================================================================
DASHSCOPE_API_KEY=your-alibaba-cloud-api-key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_ENABLE_THINKING=false

# =============================================================================
# LOCAL BGE LARGE EMBEDDINGS
# =============================================================================
BGE_MODEL_NAME=BAAI/bge-large-en-v1.5
BGE_MODEL_PATH=/app/models/bge-large-en-v1.5
BGE_DEVICE=cpu
BGE_NORMALIZE_EMBEDDINGS=true
EMBEDDING_MODEL_DIMENSIONS=1024

# =============================================================================
# DOCUMENT PROCESSING / CHUNKING CONFIGURATION
# =============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNKING_STRATEGY=recursive
SEMANTIC_BREAKPOINT_TYPE=percentile
MIN_CHUNK_SIZE=100

# =============================================================================
# RETRIEVAL SETTINGS
# =============================================================================
MAX_RETRIEVED_DOCUMENTS=5

# =============================================================================
# FILE WATCHER SETTINGS
# =============================================================================
ENABLE_FILE_WATCHER=false

# =============================================================================
# SCRAPING SETTINGS
# =============================================================================
SCRAPING_TIMEOUT=30
